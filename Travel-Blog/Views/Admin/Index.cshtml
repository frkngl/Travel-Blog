@model Travel_Blog.Models.TableList
@{
    ViewBag.Title = "Anasayfa";
    Layout = "~/Views/Shared/Admin_Layout.cshtml";
}

<div class="container">
    <div class="page-inner">
        <div class="d-flex align-items-left align-items-md-center flex-column flex-md-row pt-2 pb-4">
            <div>
                <h3 class="fw-bold mb-3">Admin Panel</h3>
                <h6 class="op-7 mb-2">Hoşgeldiniz @(Session["NameAndSurname"]?.ToString())</h6>
            </div>
            <div class="ms-md-auto py-2 py-md-0">
                <a href="#" class="btn btn-label-info btn-round me-2">Yönet</a>
                <a href="#" class="btn btn-primary btn-round">Admin Ekle</a>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-6 col-md-3">
                <div class="card card-stats card-round">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-icon">
                                <div class="icon-big text-center icon-primary bubble-shadow-small">
                                    <i class="fas fa-users"></i>
                                </div>
                            </div>
                            <div class="col col-stats ms-3 ms-sm-0">
                                <div class="numbers">
                                    <p class="card-category">Toplam Yazar Sayısı</p>
                                    <h4 class="card-title">@ViewBag.AdminCount</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div class="card card-stats card-round">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-icon">
                                <div class="icon-big text-center icon-info bubble-shadow-small">
                                    <i class="fas fa-user-check"></i>
                                </div>
                            </div>
                            <div class="col col-stats ms-3 ms-sm-0">
                                <div class="numbers">
                                    <p class="card-category">Toplam Blog Sayısı</p>
                                    <h4 class="card-title">@ViewBag.BlogCount</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div class="card card-stats card-round">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-icon">
                                <div class="icon-big text-center icon-success bubble-shadow-small">
                                    <i class="far fa-check-circle"></i>
                                </div>
                            </div>
                            <div class="col col-stats ms-3 ms-sm-0">
                                <div class="numbers">
                                    <p class="card-category">Aktif Blog Sayısı</p>
                                    <h4 class="card-title">@ViewBag.BlogCountActive</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div class="card card-stats card-round">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-icon">
                                <div class="icon-big text-center icon-secondary bubble-shadow-small">
                                    <i class="far fa-window-close"></i>
                                </div>
                            </div>
                            <div class="col col-stats ms-3 ms-sm-0">
                                <div class="numbers">
                                    <p class="card-category">Pasif Blog Sayısı</p>
                                    <h4 class="card-title">@ViewBag.BlogCountPassive</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <div class="card card-round">
                    <div class="card-body">
                        <div class="card-head-row card-tools-still-right">
                            <div class="card-title">Admin & Yazarlar</div>
                        </div>
                        @foreach (var item in Model.AdminList)
                        {
                            <div class="card-list py-4">
                                <div class="item-list">
                                    <div class="avatar">
                                        <img src="~/webimage/@item.IMAGE"
                                             class="avatar-img rounded-circle" />
                                    </div>
                                    <div class="info-user ms-3">
                                        <div class="username">@item.NAME_AND_SURNAME</div>
                                        <div class="status">@item.JOB || @item.TBLADMINROLE.ROLE</div>
                                    </div>
                                </div>
                            </div>
                        }

                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <div class="card card-round">
                    <div class="card-header">
                        <div class="card-head-row card-tools-still-right">
                            <div class="card-title">Son Atılan Bloglar</div>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <!-- Projects table -->
                            <table class="table align-items-center mb-0">
                                <tbody>
                                    @foreach (var x in Model.BlogsList.OrderByDescending(x=>x.ID).Take(8))
                                    {
                                        <tr>
                                            <th scope="row">
                                                <img src="~/webimage/@x.IMAGE" width="50" height="50" style="object-fit:cover; border-radius:50%; margin-right: 10px;" />
                                                @x.TITLE
                                            </th>
                                            <td class="text-end">@x.DATE.Value.ToString("dd.MM.yyyy")</td>
                                            <td class="text-end">@x.TBLADMIN.NAME_AND_SURNAME</td>
                                        </tr>
                                    }

                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

