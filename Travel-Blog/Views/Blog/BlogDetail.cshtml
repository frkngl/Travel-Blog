@model Travel_Blog.Models.TBLBLOGS
@{
    ViewBag.Title = Model.TITLE + " / GülBlog";
    Layout = "~/Views/Shared/User_Layout.cshtml";
}

<main class="main">

    <!-- Page Title -->
    <div class="page-title">
        <div class="container d-lg-flex justify-content-between align-items-center">
            <h1 class="mb-2 mb-lg-0">@Model.TITLE</h1>
            <nav class="breadcrumbs">
                <ol>
                    <li><a href="@Url.Action("Index", "Blog", new { categoryName = Travel_Blog.Controllers.BlogController.SeoUrlCreate(Model.TBLCATEGORY.CATEGORYNAME) })">@Model.TBLCATEGORY.CATEGORYNAME</a></li>
                    <li class="current">@Model.TITLE</li>
                </ol>
            </nav>
        </div>
    </div><!-- End Page Title -->

    <div class="container">
        <div class="row">

            <div class="col-lg-8">

                <!-- Blog Details Section -->
                <section id="blog-details" class="blog-details section">
                    <div class="container">

                        <article class="article">

                            <div class="post-img">
                                <img src="~/webimage/@Model.IMAGE" alt="@Model.TITLE" class="img-fluid w-100" style="height: 450px; object-fit: cover; border-radius: 8px;">
                            </div>

                            <h2 class="title">@Model.TITLE</h2>

                            <div class="meta-top">
                                <ul>
                                    <li class="d-flex align-items-center"><i class="bi bi-person"></i> <a href="blog-details.html">@Model.TBLADMIN.NAME_AND_SURNAME</a></li>
                                    <li class="d-flex align-items-center"><i class="bi bi-clock"></i> <a href="blog-details.html"><time datetime="2020-01-01">@Model.DATE.Value.ToString("dd.MM.yyyy")</time></a></li>
                                    <li class="d-flex align-items-center"><i class="bi bi-chat-dots"></i> <a href="blog-details.html">@Model.TBLCOMMENT.Count()</a></li>
                                </ul>
                            </div><!-- End meta top -->

                            <div class="content">
                                <p>
                                    @Model.DESCRIPTION
                                </p>

                                <blockquote>
                                    <p>
                                        @Model.DESCRIPTION2
                                    </p>
                                </blockquote>

                                <p>
                                    @Model.DESCRIPTION3
                                </p>
                            </div><!-- End post content -->

                            <div class="meta-bottom">
                                <i class="bi bi-folder"></i>
                                <ul class="cats">
                                    <li><a href="@Url.Action("Index","Blog", new {categoryName = Travel_Blog.Controllers.BlogController.SeoUrlCreate(Model.TBLCATEGORY.CATEGORYNAME) })">@Model.TBLCATEGORY.CATEGORYNAME</a></li>
                                </ul>
                            </div><!-- End meta bottom -->

                        </article>

                    </div>
                </section><!-- /Blog Details Section -->
                <!-- Blog Comments Section -->
                <section id="blog-comments" class="blog-comments section">

                    <div class="container">

                        <h4 class="comments-count">@Model.TBLCOMMENT.Where(x => x.STATUS == true).Count() Yorumlar</h4>

                        @{
                            var comments = Model.TBLCOMMENT.Where(x => x.STATUS == true && x.BLOGID == Model.ID).ToList();
                        }

                        @foreach (var y in comments)
                        {
                            <div id="comment-1" class="comment">
                                <div class="d-flex">
                                    <div class="comment-img"><img src="~/webimage/user.jpg"></div>
                                    <div>
                                        <h5><a href="">@y.NAME_AND_SURNAME</a></h5>
                                        <time datetime="2020-01-01">@y.DATE.Value.ToString("dd.MM.yyyy")</time>
                                        <p>
                                            @y.COMMENT
                                        </p>
                                    </div>
                                </div>
                            </div><!-- End comment #1 -->
                        }
                    </div>

                </section><!-- /Blog Comments Section -->
                <!-- Comment Form Section -->
                <section id="comment-form" class="comment-form section">
                    <div class="container">
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                @TempData["SuccessMessage"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }
                        @if (TempData["ErrorMessage"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                @TempData["ErrorMessage"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }
                        <form action="@Url.Action("LeaveComment", "Blog")" method="post">

                            <input type="hidden" name="BLOGID" value="@Model.ID" />

                            <h4>Yorum Gönder</h4>
                            <p>E-posta adresiniz yayınlanmayacak. Gerekli alanlar * ile işaretlenmiştir.</p>

                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <input name="NAME_AND_SURNAME" type="text" class="form-control" placeholder="Ad ve Soyad*" required>
                                </div>
                                <div class="col-md-6 form-group">
                                    <input name="EMAIL" type="email" class="form-control" placeholder="Mail*" required>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col form-group">
                                    <textarea name="COMMENT" class="form-control" placeholder="Yorum*" required></textarea>
                                </div>
                            </div>

                            <div class="text-center">
                                <button type="submit" class="btn btn-primary">Gönder</button>
                            </div>

                        </form>

                    </div>
                </section>

            </div>

            <div class="col-lg-4 sidebar">

                <div class="widgets-container">

                    <!-- Blog Author Widget -->
                    <div class="blog-author-widget widget-item">
                        <div class="d-flex flex-column align-items-center">
                            <div class="d-flex align-items-center w-100">
                                @if (Model.TBLADMIN.IMAGE != null)
                                {
                                    <img src="~/webimage/@Model.TBLADMIN.IMAGE" class="rounded-circle flex-shrink-0" alt="@Model.TBLADMIN.NAME_AND_SURNAME">
                                }
                                else
                                {
                                    <img src="~/webimage/user.jpg" class="rounded-circle flex-shrink-0" alt="@Model.TBLADMIN.NAME_AND_SURNAME">
                                }

                                <div>
                                    <h4>@Model.TBLADMIN.NAME_AND_SURNAME</h4>
                                    @if (Model.TBLADMIN.JOB != null)
                                    {
                                        <h6>@Model.TBLADMIN.JOB</h6>
                                    }
                                    else
                                    {
                                        @:Belirtilmemiş
                                    }
                                    <div class="social-links">
                                        <a href="@Model.TBLADMIN.TWITTER"><i class="bi bi-twitter-x"></i></a>
                                        <a href="@Model.TBLADMIN.INSTAGRAM"><i class="biu bi-instagram"></i></a>
                                        <a href="@Model.TBLADMIN.LINKEDIN"><i class="biu bi-linkedin"></i></a>
                                    </div>
                                </div>
                            </div>

                            <p>
                                @Model.TBLADMIN.DESCRIPTION
                            </p>
                        </div>
                    </div>

                    <!-- Recent Posts Widget -->
                    @Html.Action("GetRecentBlogs", "Blog")
                    <!-- Tags Widget -->
                    @Html.Action("GetCategories", "Blog")

                </div>

            </div>

        </div>
    </div>

</main>

