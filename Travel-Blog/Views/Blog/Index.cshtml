@using PagedList
@using PagedList.Mvc
@model Travel_Blog.Models.TableList
@{
    ViewBag.Title = Model.ActiveCategoryName + " / GülBlog";
    Layout = "~/Views/Shared/User_Layout.cshtml";
}

<main class="main">

    <!-- Page Title -->
    <div class="page-title position-relative">
        <div class="container d-lg-flex justify-content-between align-items-center">
            <h1 class="mb-2 mb-lg-0">@Model.ActiveCategoryName</h1>
            <nav class="breadcrumbs">
                <ol>
                    <li><a href="@Url.Action("Index","Home")">Anasayfa</a></li>
                    <li class="current">@Model.ActiveCategoryName</li>
                </ol>
            </nav>
        </div>
    </div><!-- End Page Title -->

    <div class="container">
        <div class="row">

            <div class="col-lg-8">

                <!-- Blog Posts Section -->
                <section id="blog-posts" class="blog-posts section">
                    <div class="container">
                        <div class="row gy-4">

                            @if (Model.PagedBlogsList.Count == 0)
                            {
                                <div class="col-12">
                                    <div class="alert alert-warning text-center py-5" role="alert">
                                        <i class="bi bi-search d-block mb-3" style="font-size: 3rem; color: #ffc107;"></i>
                                        <h4 class="alert-heading">Sonuç Bulunamadı!</h4>
                                        <p class="mb-0">"<strong>@ViewBag.CurrentSearch</strong>" aramasına ait herhangi bir blog yazısı bulamadık. Lütfen farklı kelimelerle tekrar denemeyi veya kategorilere göz atmayı unutmayın.</p>
                                    </div>
                                </div>
                            }
                            else
                            {
                                foreach (var x in Model.PagedBlogsList)
                                {
                                    <div class="col-lg-6">
                                        <article class="position-relative h-100 d-flex flex-column">

                                            <div class="post-img position-relative overflow-hidden">
                                                <img src="~/webimage/@x.IMAGE" class="img-fluid w-100" style="height: 250px; object-fit: cover;" alt="@x.TITLE">
                                                <span class="post-date">@x.DATE.Value.ToString("dd.MM.yyyy")</span>
                                            </div>

                                            <div class="post-content d-flex flex-column flex-grow-1">

                                                <h3 class="post-title">@x.TITLE</h3>

                                                <div class="meta d-flex align-items-center">
                                                    <div class="d-flex align-items-center">
                                                        <i class="bi bi-person"></i> <span class="ps-2">@x.TBLADMIN.NAME_AND_SURNAME</span>
                                                    </div>
                                                    <span class="px-3 text-black-50">/</span>
                                                    <div class="d-flex align-items-center">
                                                        <i class="bi bi-folder2"></i> <span class="ps-2">@x.TBLCATEGORY.CATEGORYNAME</span>
                                                    </div>
                                                </div>

                                                <p>
                                                    @(x.DESCRIPTION != null && x.DESCRIPTION.Length > 200 ? x.DESCRIPTION.Substring(0, 200) + "..." : x.DESCRIPTION)
                                                </p>

                                                <hr class="mt-auto">

                                                <a href="@Url.Action("BlogDetail", "Blog", new { seourl = Travel_Blog.Controllers.BlogController.SeoUrlCreate(x.TITLE) })" class="readmore stretched-link"><span>Daha Fazla Oku</span><i class="bi bi-arrow-right"></i></a>

                                            </div>

                                        </article>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </section>
                <!-- Blog Pagination Section -->
                <section id="blog-pagination" class="blog-pagination section">
                    <div class="container">
                        <div class="d-flex justify-content-center">
                            @Html.PagedListPager(Model.PagedBlogsList, page => Url.Action("Index", new
                            {
                                page,
                                categoryName = ViewContext.RouteData.Values["categoryName"],
                                searchString = ViewBag.CurrentSearch
                            }),
                                               new PagedListRenderOptions
                                               {
                                                   LiElementClasses = new string[] { "page-item" },
                                                   FunctionToTransformEachPageLink = (liTag, aTag) =>
                                                   {
                                                       aTag.Attributes.Add("class", "page-link");
                                                       liTag.InnerHtml = aTag.ToString();
                                                       return liTag;
                                                   }
                                               })
                        </div>
                    </div>
                </section>

            </div>

            <div class="col-lg-4 sidebar">

                <div class="widgets-container">
                    @foreach (var item in Model.AdminList.Take(1))
                    {
                        <div class="blog-author-widget-2 widget-item">

                            <div class="d-flex flex-column align-items-center">
                                <img src="~/webimage/@item.IMAGE" class="rounded-circle flex-shrink-0" alt="">
                                <h4>@item.NAME_AND_SURNAME</h4>
                                <h6>@item.JOB</h6>
                                <div class="social-links">
                                    <a href="@item.TWITTER"><i class="bi bi-twitter-x"></i></a>
                                    <a href="@item.INSTAGRAM"><i class="biu bi-instagram"></i></a>
                                    <a href="@item.LINKEDIN"><i class="biu bi-linkedin"></i></a>
                                </div>

                                <p>
                                    @item.DESCRIPTION
                                </p>

                            </div>
                        </div>
                    }
                    <!-- Blog Author Widget 2 -->
                    <!--/Blog Author Widget 2 -->
                    <!-- Search Widget -->
                    <div class="search-widget widget-item">
                        <h3 class="widget-title">Arama</h3>

                        <form action="@Url.Action("Index", "Blog")" method="get">

                            @if (ViewContext.RouteData.Values["categoryName"] != null)
                            {
                                <input type="hidden" name="categoryName" value="@ViewContext.RouteData.Values["categoryName"]" />
                            }

                            <input type="text" name="searchString" value="@ViewBag.CurrentSearch" placeholder="Bloglarda ara...">
                            <button type="submit" title="Search"><i class="bi bi-search"></i></button>

                        </form>
                    </div>
                    @Html.Action("GetRecentBlogs", "Blog")
                    <!-- Tags Widget -->
                    @Html.Action("GetCategories", "Blog")
                </div>

            </div>

        </div>
    </div>

</main>

