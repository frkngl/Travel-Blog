@using PagedList
@using PagedList.Mvc
@model Travel_Blog.Models.TableList
@{
    ViewBag.Title = Model.ActiveCategoryName + " / GülBlog";
    Layout = "~/Views/Shared/User_Layout.cshtml";
}

<main class="main">

    <!-- Page Title -->
    <div class="page-title position-relative">
        <div class="container d-lg-flex justify-content-between align-items-center">
            <h1 class="mb-2 mb-lg-0">Kategori</h1>
            <nav class="breadcrumbs">
                <ol>
                    <li><a href="@Url.Action("Index","Home")">Anasayfa</a></li>
                    <li class="current">@Model.ActiveCategoryName</li>
                </ol>
            </nav>
        </div>
    </div><!-- End Page Title -->

    <div class="container">
        <div class="row">

            <div class="col-lg-8">

                <!-- Blog Posts Section -->
                <section id="blog-posts" class="blog-posts section">
                    <div class="container">
                        <div class="row gy-4">
                            @foreach (var x in Model.BlogsList)
                            {
                                <div class="col-lg-6">
                                    <!-- 1. article etiketine d-flex ve flex-column eklendi -->
                                    <article class="position-relative h-100 d-flex flex-column">

                                        <div class="post-img position-relative overflow-hidden">
                                            <img src="~/webimage/@x.IMAGE" class="img-fluid w-100" style="height: 250px; object-fit: cover;" alt="@x.TITLE">
                                            <span class="post-date">@x.DATE.Value.ToString("dd.MM.yyyy")</span>
                                        </div>

                                        <div class="post-content d-flex flex-column flex-grow-1">

                                            <h3 class="post-title">@x.TITLE</h3>

                                            <div class="meta d-flex align-items-center">
                                                <div class="d-flex align-items-center">
                                                    <i class="bi bi-person"></i> <span class="ps-2">@x.TBLADMIN.NAME_AND_SURNAME</span>
                                                </div>
                                                <span class="px-3 text-black-50">/</span>
                                                <div class="d-flex align-items-center">
                                                    <i class="bi bi-folder2"></i> <span class="ps-2">@x.TBLCATEGORY.CATEGORYNAME</span>
                                                </div>
                                            </div>

                                            <p>
                                                @(x.DESCRIPTION != null && x.DESCRIPTION.Length > 200 ? x.DESCRIPTION.Substring(0, 200) + "..." : x.DESCRIPTION)
                                            </p>

                                            <!-- 3. mt-auto sınıfı ile hr ve altındaki link kartın en altına itildi -->
                                            <hr class="mt-auto">

                                            <a href="#" class="readmore stretched-link"><span>Daha Fazla Oku</span><i class="bi bi-arrow-right"></i></a>

                                        </div>

                                    </article>
                                </div>
                            }
                        </div>
                    </div>
                </section>
                <!-- Blog Pagination Section -->
                <section id="blog-pagination" class="blog-pagination section">
                    <div class="container">
                        <div class="d-flex justify-content-center">

                            @Html.PagedListPager(Model.BlogsList, page => Url.Action("Index", new { page, categoryName = ViewContext.RouteData.Values["categoryName"] }),
                                     new PagedListRenderOptions
                                     {
                                         LiElementClasses = new string[] { "page-item" },
                                         FunctionToTransformEachPageLink = (liTag, aTag) =>
                                         {
                                             aTag.Attributes.Add("class", "page-link");
                                             liTag.InnerHtml = aTag.ToString();
                                             return liTag;
                                         }
                                     })

                        </div>
                    </div>
                </section>

            </div>

            <div class="col-lg-4 sidebar">

                <div class="widgets-container">
                    @foreach (var item in Model.AdminList.Take(1))
                    {
                        <div class="blog-author-widget-2 widget-item">

                            <div class="d-flex flex-column align-items-center">
                                <img src="~/webimage/@item.IMAGE" class="rounded-circle flex-shrink-0" alt="">
                                <h4>@item.NAME_AND_SURNAME</h4>
                                <div class="social-links">
                                    <a href="@item.TWITTER"><i class="bi bi-twitter-x"></i></a>
                                    <a href="@item.INSTAGRAM"><i class="biu bi-instagram"></i></a>
                                    <a href="@item.LINKEDIN"><i class="biu bi-linkedin"></i></a>
                                </div>

                                <p>
                                    @item.DESCRIPTION
                                </p>

                            </div>
                        </div>
                    }
                    <!-- Blog Author Widget 2 -->
                    <!--/Blog Author Widget 2 -->
                    <!-- Search Widget -->
                    <div class="search-widget widget-item">

                        <h3 class="widget-title">Arama</h3>
                        <form action="">
                            <input type="text">
                            <button type="submit" title="Search"><i class="bi bi-search"></i></button>
                        </form>

                    </div><!--/Search Widget -->
                    <!-- Recent Posts Widget -->
                    <div class="recent-posts-widget widget-item">

                        <h3 class="widget-title">Karışık Postlar</h3>

                        @foreach (var item in Model.BlogsList.OrderByDescending(x => Guid.NewGuid()).Take(5))
                        {
                            <div class="post-item">
                                <img src="~/webimage/@item.IMAGE" alt="@item.TITLE" class="flex-shrink-0" style="width: 120px; height: 80px; object-fit: cover;">
                                <div>
                                    <h4><a href="blog-details.html">@item.TITLE</a></h4>
                                    <time datetime="2020-01-01">@item.DATE.Value.ToString("dd.MM.yyyy")</time>
                                </div>
                            </div><!-- End recent post item-->
                        }

                    </div><!--/Recent Posts Widget -->
                    <!-- Tags Widget -->
                    <div class="tags-widget widget-item">

                        <h3 class="widget-title">Kategoriler</h3>
                        <ul>
                            @foreach (var item in Model.CategoryList)
                            {
                                string seoUrl = item.CATEGORYNAME.ToLower()
                                .Replace("ş", "s").Replace("ç", "c").Replace("ı", "i")
                                .Replace("ğ", "g").Replace("ö", "o").Replace("ü", "u")
                                .Replace(" ", "-");
                                <li><a href="@Url.Action("Index","Blog", new { categoryName = seoUrl})">@item.CATEGORYNAME</a></li>
                            }
                        </ul>

                    </div><!--/Tags Widget -->

                </div>

            </div>

        </div>
    </div>

</main>

