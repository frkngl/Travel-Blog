@model Tuple<Travel_Blog.Models.TBLABOUT, List<Travel_Blog.Models.TBLADMIN>>
@{
    ViewBag.Title = "Hakkımızda | GülBlog";
    Layout = "~/Views/Shared/User_Layout.cshtml";
}

<main class="main">

    <!-- Page Title -->
    <div class="page-title">
        <div class="container d-lg-flex justify-content-between align-items-center">
            <h1 class="mb-2 mb-lg-0">Hakkımızda</h1>
            <nav class="breadcrumbs">
                <ol>
                    <li><a href="@Url.Action("Index","Home")">Anasayfa</a></li>
                    <li class="current">Hakkımızda</li>
                </ol>
            </nav>
        </div>
    </div><!-- End Page Title -->
    <!-- About Section -->
    <section id="about" class="about section">

        <div class="container">

            <div class="row gy-4">

                <div class="col-lg-6 content" data-aos="fade-up" data-aos-delay="100">
                    <p class="who-we-are">Biz Kimiz?</p>
                    <h3>@Model.Item1.TITLE</h3>
                    <p class="fst-italic">
                        @Model.Item1.ALTTITLE
                    </p>
                    <ul>
                        <li><i class="bi bi-check-circle"></i> <span>@Model.Item1.LİST1</span></li>
                        <li><i class="bi bi-check-circle"></i> <span>@Model.Item1.LİST2</span></li>
                        <li><i class="bi bi-check-circle"></i> <span>@Model.Item1.LİST3</span></li>
                    </ul>
                </div>

                <div class="col-lg-6 about-images" data-aos="fade-up" data-aos-delay="200">
                    <div class="row gy-4">
                        <div class="col-lg-6">
                            <img src="~/webimage/@Model.Item1.IMAGE" class="img-fluid" alt="">
                        </div>
                        <div class="col-lg-6">
                            <div class="row gy-4">
                                <div class="col-lg-12">
                                    <img src="~/webimage/@Model.Item1.IMAGE2" class="img-fluid" alt="">
                                </div>
                                <div class="col-lg-12">
                                    <img src="~/webimage/@Model.Item1.IMAGE3" class="img-fluid" alt="">
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

        </div>
    </section><!-- /About Section -->
    <!-- Team Section -->
    <section id="team" class="team section">

        <!-- Section Title -->
        <div class="container section-title" data-aos="fade-up">
            <div class="section-title-container d-flex align-items-center justify-content-between">
                <h2>Takım</h2>
                <p>Neşeli, macera, meraklı ekibimizle tanışın</p>
            </div>
        </div><!-- End Section Title -->

        <div class="container">

            <div class="row gy-4">
                @foreach (var admin in Model.Item2)
                {
                    <div class="col-lg-6" data-aos="fade-up" data-aos-delay="100">
                        <div class="team-member d-flex align-items-start">
                            <div class="pic"><img src="~/webimage/@admin.IMAGE" class="img-fluid" alt="@admin.NAME_AND_SURNAME"></div>
                            <div class="member-info">
                                <h4>@admin.NAME_AND_SURNAME</h4>
                                <span>@admin.TBLADMINROLE.ROLE</span>
                                <p>@admin.DESCRIPTION</p>
                                <div class="social">
                                    <a href="@admin.TWITTER" target="_blank"><i class="bi bi-twitter-x"></i></a>
                                    <a href="@admin.INSTAGRAM" target="_blank"><i class="bi bi-instagram"></i></a>
                                    <a href="@admin.LINKEDIN" target="_blank"> <i class="bi bi-linkedin"></i> </a>
                                </div>
                            </div>
                        </div>
                    </div><!-- End Team Member -->
                }
            </div>

        </div>

    </section><!-- /Team Section -->

</main>

