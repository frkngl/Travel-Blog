
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>@ViewBag.Title</title>
    <meta name="description" content="">
    <meta name="keywords" content="">

    <!-- Favicons -->
    <link href="~/Travel-Blog/assets/img/favicon.png" rel="icon">
    <link href="~/Travel-Blog/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700;800;900&family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600;1,700;1,800&display=swap" rel="stylesheet">

    <!-- Vendor CSS Files -->
    <link href="~/Travel-Blog/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/Travel-Blog/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/Travel-Blog/assets/vendor/aos/aos.css" rel="stylesheet">
    <link href="~/Travel-Blog/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">

    <!-- Main CSS File -->
    <link href="~/Travel-Blog/assets/css/main.css" rel="stylesheet">

    <!-- =======================================================
    * Template Name: ZenBlog
    * Template URL: https://bootstrapmade.com/zenblog-bootstrap-blog-template/
    * Updated: Aug 08 2024 with Bootstrap v5.3.3
    * Author: BootstrapMade.com
    * License: https://bootstrapmade.com/license/
    ======================================================== -->
</head>

<body class="index-page">
    @{
        var db = new Travel_Blog.Models.TravelBlogEntities();
        var contact = db.TBLCONTACT.FirstOrDefault();
        var social = db.TBLADMIN.FirstOrDefault();
        var catogory = db.TBLCATEGORY.ToList();
    }
    <header id="header" class="header d-flex align-items-center sticky-top">
        <div class="container position-relative d-flex align-items-center justify-content-between">

            <a href="@Url.Action("Index", "Home")" class="logo d-flex align-items-center me-auto me-xl-0">
                <!-- Uncomment the line below if you also wish to use an image logo -->
                <!-- <img src="assets/img/logo.png" alt=""> -->
                <h1 class="sitename">GülBlog</h1>
            </a>

            <nav id="navmenu" class="navmenu">
                <ul>
                    <li><a href="@Url.Action("Index", "Home")" class="active">Anasayfa</a></li>
                    <li><a href="@Url.Action("About", "Home")">Hakkımızda</a></li>
                    <li class="dropdown">
                        <a href="#"><span>Kategoriler</span> <i class="bi bi-chevron-down toggle-dropdown"></i></a>
                        <ul>
                            @foreach (var item in catogory)
                            {
                                <li><a href="#">@item.CATEGORYNAME</a></li>
                            }
                        </ul>
                    </li>
                    <li><a href="@Url.Action("Contact", "Home")">İletişim</a></li>
                </ul>
                <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
            </nav>

            <div class="header-social-links">
                <a href="@social.TWITTER" target="_blank" class="twitter"><i class="bi bi-twitter-x"></i></a>
                <a href="@social.INSTAGRAM" target="_blank" class="instagram"><i class="bi bi-instagram"></i></a>
                <a href="@social.LINKEDIN" target="_blank" class="linkedin"><i class="bi bi-linkedin"></i></a>
            </div>

        </div>
    </header>

    @RenderBody()

    <footer id="footer" class="footer dark-background">

        <div class="container footer-top">
            <div class="row gy-4">
                <div class="col-lg-4 col-md-6 footer-about">
                    <a href="@Url.Action("Index", "Home")" class="logo d-flex align-items-center">
                        <span class="sitename">GülBlog</span>
                    </a>
                    <div class="footer-contact pt-3">
                        <p>@contact.ADDRESS</p>
                        <p class="mt-3"><strong>Phone:</strong> <span>+90 @contact.PHONE</span></p>
                        <p><strong>Email:</strong> <span>@contact.EMAIL</span></p>
                    </div>
                    <div class="social-links d-flex mt-4">
                        <a href="@social.TWITTER" target="_blank"><i class="bi bi-twitter-x"></i></a>
                        <a href="@social.INSTAGRAM" target="_blank"><i class="bi bi-instagram"></i></a>
                        <a href="@social.LINKEDIN" target="_blank"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6 footer-links">
                    <h4>Kategoriler</h4>
                    <div class="row">
                        <div class="col-6">
                            <ul class="list-unstyled">
                                @foreach (var item in catogory.Take(4))
                                {
                                    <li><a href="#">@item.CATEGORYNAME</a></li>
                                }
                            </ul>
                        </div>

                        <div class="col-6">
                            <ul class="list-unstyled">
                                @foreach (var item in catogory.Skip(4))
                                {
                                    <li><a href="#">@item.CATEGORYNAME</a></li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6 d-flex justify-content-center align-items-center mt-3 mt-md-0">
                    <div class="w-100" style="max-width: 480px;">
                        <div class="ratio ratio-21x9">
                            <img src="~/webimage/footer.jpg" alt="Görsel" class="img-fluid rounded object-fit-cover" />
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="container copyright text-center mt-4">
            <p>© <span>Telif Hakkı</span> <strong class="px-1 sitename">GülBlog</strong> <span>Tüm Hakları Saklıdır</span></p>
        </div>

    </footer>

    <!-- Scroll Top -->
    <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

    <!-- Preloader -->
    <div id="preloader"></div>

    <!-- Vendor JS Files -->
    <script src="~/Travel-Blog/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/Travel-Blog/assets/vendor/php-email-form/validate.js"></script>
    <script src="~/Travel-Blog/assets/vendor/aos/aos.js"></script>
    <script src="~/Travel-Blog/assets/vendor/swiper/swiper-bundle.min.js"></script>

    <!-- Main JS File -->
    <script src="~/Travel-Blog/assets/js/main.js"></script>

</body>

</html>
